{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algos.data.gouv.fr/schemas/record.schema.json",
  "title": "Service (Règle)",
  "description": "Schéma d'une fiche de règle (service public) et de ses métadonnées de base. Un fichier de data/ contient exactement un objet décrit par ce schéma.",
  "version": "0.2.0",
  "x-unique-fields": ["id", "identifier"],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "URI canonique de la règle (ex: https://algos.data.gouv.fr/regles/cnaf/prime-activite)."
    },
    "identifier": {
      "type": "string",
      "description": "Identifiant unique de la règle (ex: solidarite.prime-activite.openfisca-france)."
    },
    "version": {
      "type": "string",
      "description": "Version semver de la règle (ex: 169.15.0)."
    },
    "title": {
      "type": "object",
      "description": "Titre multilingue. Exemple: {\"fr\": \"Prime d'activité\", \"en\": \"Activity Bonus\"}.",
      "properties": {
        "fr": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["fr"],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "description": "Description multilingue de la règle.",
      "properties": {
        "fr": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["fr"],
      "additionalProperties": false
    },
    "valid_from": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de début de validité (dct:valid)."
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de fin de validité (dct:valid)."
    },
    "subjects": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Tags thématiques (ex: ['prime-activite', 'minima-sociaux'])."
    },
    "source_repository": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "URL du dépôt source (dct:source, ex: https://github.com/openfisca/openfisca-france)."
    },
    "source_commit": {
      "type": ["string", "null"],
      "description": "SHA du commit épinglé (schema:SoftwareSourceCode)."
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de création de la fiche."
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de dernière mise à jour."
    },
    "competent_authority": {
      "type": "object",
      "description": "Organisation compétente (cv:hasCompetentAuthority).",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "URI de l'organisation."
        },
        "name": {
          "type": "string",
          "description": "Nom de l'organisation (ex: Ministère de la Culture)."
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "thematic_area": {
      "type": "string",
      "enum": ["solidarity", "taxation", "employment", "retirement", "housing", "culture", "health", "citizenship"],
      "description": "Domaine de politique publique (cv:thematicArea)."
    },
    "engine": {
      "type": "string",
      "enum": ["publicodes", "openfisca", "catala", "other"],
      "description": "Moteur de calcul avec lequel la règle est écrite. other : code écrit sans l'un des trois autres moteurs."
    },
    "source_openness": {
      "type": "string",
      "enum": ["open", "hybrid", "closed"],
      "description": "Ouverture du code. open : tout le code de la règle est public dans source_repository. hybrid : une partie du code est publique. closed : aucun code n'est public."
    },
    "legal_resources": {
      "type": ["array", "null"],
      "minItems": 1,
      "description": "Textes qui fondent la règle (cv:hasLegalResource).",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Désignation du texte, article compris (ex: Code électoral, article L.2)."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Adresse où lire le texte, son ELI quand il en a un."
          }
        },
        "required": ["title", "url"],
        "additionalProperties": false
      }
    },
    "input_schema": {
      "description": "Schéma JSON (draft 2020-12) décrivant les entrées attendues par l'algorithme, validé contre le métaschema officiel. Exemple: {\"type\": \"object\", \"properties\": {\"age\": {\"type\": \"integer\"}}, \"required\": [\"age\"]}. null si les entrées ne sont pas documentées.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        }
      ]
    }
  },
  "required": [
    "id",
    "identifier",
    "version",
    "title",
    "description",
    "valid_from",
    "valid_to",
    "subjects",
    "source_repository",
    "source_commit",
    "created_at",
    "updated_at",
    "competent_authority",
    "thematic_area",
    "engine",
    "source_openness",
    "legal_resources",
    "input_schema"
  ]
}
